# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Set after running `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create products in Stripe Dashboard then paste IDs here)
# Tier 1: $1.95 / 3-day intro → $24.99 / week
STRIPE_PRICE_INTRO_3D=price_...
# Tier 2: $6.99 / 7-day intro → $24.99 / week
STRIPE_PRICE_INTRO_7D=price_...
# Tier 3: $17.99 / 1-month intro → $47.99 / month
STRIPE_PRICE_INTRO_1M=price_...
# Recurring prices (referenced by subscription schedules)
STRIPE_PRICE_RECUR_WEEK=price_...   # $24.99/week
STRIPE_PRICE_RECUR_MONTH=price_...  # $47.99/month

# Upsell one-time prices
STRIPE_PRICE_PDF_BOOK=price_...           # $14.99
STRIPE_PRICE_PARENTS_COMPARE=price_...    # $9.99
STRIPE_PRICE_AGES_PORTRAITS=price_...     # $9.99
STRIPE_PRICE_CULTURAL_DEEPDIVE=price_...  # $4.99

# ─── AI providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
REPLICATE_API_TOKEN=r8_...
FACEPP_API_KEY=
FACEPP_API_SECRET=

# ─── Email (transactional) ────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@facelineage.com

# ─── Analytics (optional for v1) ──────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
