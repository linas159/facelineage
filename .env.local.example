# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Set after running `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (auto-created by `npm run stripe:setup`, paste output here)
# Note: intro fee is charged via PaymentIntent (not a Stripe Price), so only
# the recurring weekly/monthly prices are listed in Stripe's catalog.
STRIPE_PRICE_RECUR_WEEK=price_...
STRIPE_PRICE_RECUR_MONTH=price_...

# Upsell one-time prices (5 add-ons)
STRIPE_PRICE_UPSELL_PARENTS=price_...
STRIPE_PRICE_UPSELL_ETHNICITY=price_...
STRIPE_PRICE_UPSELL_AGES=price_...
STRIPE_PRICE_UPSELL_PARTNER=price_...
STRIPE_PRICE_UPSELL_BOOK=price_...

# ─── AI providers ─────────────────────────────────────────────────────────────
# Claude — face analysis (vision) + heritage narrative
ANTHROPIC_API_KEY=sk-ant-...
# Replicate — runs nano-banana (gemini-2.5-flash-image) for portraits
REPLICATE_API_TOKEN=r8_...
# Optional: direct Google AI Studio key (cheaper than Replicate); if set, used
# instead of Replicate for image generation.
GOOGLE_AI_API_KEY=

# ─── Email (transactional) ────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@facelineage.com

# ─── Merchanto Prevent (Visa Order Insight / Mastercard Clarity) ──────────────
# Basic Auth credentials issued by Merchanto. Merchanto sends these on every
# lookup and notification; the endpoints reject everything without them, so
# leaving them unset disables the integration rather than opening it up.
PREVENT_API_USERNAME=
PREVENT_API_PASSWORD=
# Customer-service phone in E.164, e.g. +37052112233.
# REQUIRED FOR VISA — an Order Insight response without
# merchantInformation.merchantContactPhone is scored Invalid and never reaches
# the issuer. Mastercard Clarity does not require it and works fine unset.
# Use a dedicated business line: this number is shown to cardholders in their
# banking app and read out by dispute call-centre agents.
PREVENT_MERCHANT_PHONE=
# Merchant name component of the billing descriptor, exactly as it appears on
# the cardholder's statement (Stripe → Settings → Public details).
PREVENT_STATEMENT_DESCRIPTOR=FACELINEAGE.COM
# ISO 18245 category code. Comes from STRIPE (our acquirer), not Merchanto —
# read `business_profile.mcc` off the live account. Omitted from responses when
# blank, which is better than sending a wrong one.
PREVENT_MERCHANT_MCC=

# ─── Analytics (optional for v1) ──────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Meta Pixel + Conversions API ─────────────────────────────────────────────
# Events Manager → Dataset → Settings. The PIXEL_ID is also called Dataset ID.
# Public — embedded in the browser Pixel snippet (loaded from layout.tsx).
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only — used by /lib/meta/capi.ts to send server-side events.
META_CAPI_ACCESS_TOKEN=
# Optional. Set to the test code shown in Events Manager → Test Events while
# verifying. Remove (or leave blank) for production traffic.
META_TEST_EVENT_CODE=
